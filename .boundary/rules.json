{
  "version": 1,
  "documentation": {
    "extensions": [
      ".md",
      ".mdx",
      ".markdown",
      ".txt",
      ".rst",
      ".adoc"
    ],
    "namePrefixes": [
      "README",
      "LICENSE",
      "LICENCE",
      "NOTICE",
      "COPYING",
      "CHANGELOG",
      "CONTRIBUTING",
      "SECURITY",
      "AUTHORS"
    ],
    "dirs": [
      "docs/"
    ],
    "githubNonDocs": [
      ".github/workflows/",
      ".github/CODEOWNERS"
    ]
  },
  "privatePaths": [
    "(^|/)AGENTS\\.md$",
    "(^|/)CLAUDE\\.md$",
    "(^|/)\\.agents(/|$)",
    "(^|/)\\.claude(/|$)",
    "(^|/)\\.codex(/|$)",
    "(^|/)CODE_REVIEW_PROMPT\\.md$",
    "(^|/)IMPLEMENTATION_STATUS\\.md$",
    "(^|/)PROJECT_SPEC\\.md$",
    "(^|/)DECISIONS\\.md$",
    "(^|/)[^/]*_PLAN\\.md$",
    "^docs/evidence(/|$)",
    "^docs/internal(/|$)",
    "(^|/)FEATURE_INVENTORY\\.md$",
    "(^|/)MIGRATION_MAPPING\\.md$",
    "(^|/)LICENSE_REVIEW\\.md$",
    "^reference(/|$)",
    "(^|/)graphify-out(/|$)"
  ],
  "excludedReferences": [
    "AGENTS.md",
    "CLAUDE.md",
    ".agents",
    ".claude",
    ".codex",
    "CODE_REVIEW_PROMPT",
    "IMPLEMENTATION_STATUS",
    "PROJECT_SPEC",
    "DECISIONS.md",
    "D084_PLAN",
    "_PLAN.md",
    "docs/evidence",
    "docs/internal",
    "FEATURE_INVENTORY",
    "MIGRATION_MAPPING",
    "LICENSE_REVIEW",
    "graphify"
  ],
  "identifiers": [
    {
      "id": "decision",
      "pattern": "\\bD-\\d{3}\\b"
    },
    {
      "id": "review",
      "pattern": "\\bM\\d{1,2}-[PRA]?\\d{1,3}\\b"
    },
    {
      "id": "d084-review",
      "pattern": "\\bD84-[A-Z0-9-]+"
    },
    {
      "id": "amendment-review",
      "pattern": "\\bA\\d-R\\d+[a-z]?\\b"
    },
    {
      "id": "audit",
      "pattern": "\\bPUB-\\d+\\b"
    },
    {
      "id": "plan-file",
      "pattern": "\\bM\\d{1,2}_PLAN\\b"
    },
    {
      "id": "milestone",
      "pattern": "\\bM(?:1[0-2]|[1-9])\\b(?![\\s,]*-?\\.?\\d)"
    },
    {
      "id": "milestone-variable",
      "pattern": "\\bM\\d{1,2}_[A-Z]"
    },
    {
      "id": "plan-step",
      "pattern": "\\b[UPLV]\\d{1,2}\\b"
    },
    {
      "id": "gate-check",
      "pattern": "\\b[PSWG]-\\d{1,2}a?\\b"
    }
  ],
  "pathIdentifiers": [
    "(^|/)m(?:[1-9]|1[0-2])[-.][^/]*\\.(?:test|spec)\\.[cm]?[jt]sx?$"
  ],
  "genericTerms": [
    "counsel",
    "lawyer",
    "attorney",
    "legal review",
    "coding agent",
    "codex",
    "claude",
    "re-review",
    "focused review",
    "independent review"
  ],
  "email": {
    "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*",
    "allowDomains": [
      "example.com",
      "example.org",
      "example.net",
      "localhost",
      "users.noreply.github.com"
    ],
    "allowSuffixes": [
      ".example.com",
      ".example.org",
      ".example.net",
      ".test",
      ".invalid",
      ".example",
      ".localhost"
    ]
  },
  "workstationPaths": [
    "\\b[A-Za-z]:\\\\[^\\s\"'`]+",
    "\\b[A-Za-z]:/(?:Users|websites)/",
    "/Users/[^/\\s]+",
    "/home/[^/\\s]+",
    "AppData"
  ],
  "exemptions": [
