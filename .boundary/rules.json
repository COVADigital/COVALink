    }
  ],
  "ruleFiles": [
    ".boundary/check.mjs",
    ".boundary/rules.json",
    ".boundary/manifest.json",
    ".boundary/exceptions.json",
    ".boundary/approved-links.json",
    ".boundary/workflow.mjs"
  ],
  "boundaryFiles": [
    ".boundary/check.mjs",
    ".boundary/rules.json",
    ".boundary/manifest.json",
    ".boundary/exceptions.json",
    ".boundary/approved-links.json",
    ".github/workflows/boundary.yml",
    ".github/CODEOWNERS",
    "CODEOWNERS",
    ".gitignore",
    ".boundary/workflow.mjs",
    ".gitleaks.toml"
  ],
  "gitignoreRequired": [
    "/.agents/",
    "/.claude/",
    "/.codex/",
    "/AGENTS.md",
    "/CLAUDE.md",
    "/docs/internal/",
    "/reference/",
    "**/graphify-out/"
  ],
  "boundaryWorkflow": ".github/workflows/boundary.yml",
  "workflowsDir": ".github/workflows/",
  "approval": {
    "context": "covalink/private-boundary",
    "creator": "COVADigital"
  },
  "boundaryDirs": [
    ".boundary/"
  ]
}
