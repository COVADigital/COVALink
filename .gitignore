# COVALink repository root ignore rules.
# Rules without a leading slash apply at every depth (e.g. web/node_modules).

# --- Local-only material: never part of this repository ---
/.agents/
/.claude/
/.codex/
/AGENTS.md
/CLAUDE.md
/docs/internal/
/reference/
**/graphify-out/

# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Framework / build output ---
.next/
out/
build/
dist/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# --- Environment files (secrets). Only the documented example is tracked. ---
.env
.env.*
!.env.example

# --- Runtime data (uploads, local storage) ---
web/data/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Tests ---
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/
*.lcov

# --- Keys and certificates ---
*.pem
*.key
*.p12

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
