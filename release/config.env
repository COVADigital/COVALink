# Pinned inputs for the COVALink release tooling: the candidate and promotion
# workflows, the source-bundle builder and the candidate gates. Every image is
# pinned by digest. Change a value only through a reviewed pull request, and
# rebuild the source bundle and the component notices when a pin changes.

# Base image of web/Dockerfile. Must equal its NODE_IMAGE default.
NODE_IMAGE=node:24.22.2-alpine3.24@sha256:8a32c8cf649a49915a66e81e7a609223c708d0adabf288ee3f4077d765542f85

# Temporary Alpine security update applied on top of NODE_IMAGE (web/Dockerfile,
# stage "patched-base"), until a reviewed Node base-image digest ships the same or
# a newer fixed package. The Dockerfile must install exactly zlib=<this version>.
# CVE-2026-4738 is fixed in zlib 1.4. Removing the update needs its own dedicated review
# and proof that the replacement base image already contains the fix.
ALPINE_ZLIB_VERSION=1.4-r0
ALPINE_ZLIB_FIXES=CVE-2026-4738

# Build toolchain. The Dockerfile frontend (web/Dockerfile's "# syntax=" line must
# equal this; it provides the secret mount's env= option) and the BuildKit image
# the release workflows' builder runs. The candidate build fails if the builder's
# effective BuildKit version or the frontend that resolved differs from these.
DOCKERFILE_FRONTEND=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
BUILDKIT_IMAGE=moby/buildkit:v0.34.1@sha256:99368f3e46177c6405b9740e4461d91cee004128daeecca78d4ceac50ec1da5c

# Fetches Alpine package recipes and their upstream sources.
ALPINE_FETCH_IMAGE=alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# The upstream prebuilt libvips package that sharp loads, used unchanged. Its
# source materials come from the sharp-libvips repository at this exact commit,
# which is the commit of tag v<version>.
SHARP_LIBVIPS_PACKAGE=@img/sharp-libvips-linuxmusl-x64
SHARP_LIBVIPS_VERSION=1.3.4
SHARP_LIBVIPS_COMMIT=ebb95f8add54eee8bed840e3fb587e4cbec857d7

# Pins applied to the upstream sharp-libvips build environment, so the bundled
# rebuild kit and its vendored Rust crates are reproducible from this file.
LIBVIPS_BUILD_BASE=alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
LIBVIPS_RUST_TOOLCHAIN=nightly-2026-09-27
LIBVIPS_CARGO_C_VERSION=0.10.25+cargo-0.99.0
LIBVIPS_MESON_VERSION=1.12.1

# Supply-chain scanners.
SBOM_GENERATOR=docker/buildkit-syft-scanner:1.12.1@sha256:873a7458c3c8ac8e32c7b796c10e1600b07b963d2aa000a72a2d97aaaa2d6315
SYFT_IMAGE=anchore/syft:v1.57.0@sha256:3c70e6d5979364cefdc22b51617a78fd264574d3bd6b4f84a351204147025e2a
GRYPE_IMAGE=anchore/grype:v0.121.2@sha256:6a36234da13f9faa327306ac0b3dab3405cfa2b4eb20c8f904125a8707863913

# Registry packages. Staging always stays private.
STAGING_PACKAGE=ghcr.io/covadigital/covalink-staging
PRODUCTION_PACKAGE=ghcr.io/covadigital/covalink
SOURCES_PACKAGE=ghcr.io/covadigital/covalink-sources
