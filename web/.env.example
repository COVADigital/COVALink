# COVALink environment variables. Copy to `.env` for local development:
#   PowerShell:  Copy-Item .env.example .env
# Every variable read by src/lib/env.ts is listed here. Values below are
# placeholders/examples only; never commit real secrets.
#
# Production (Docker Compose / Coolify): these are set in the deployment
# environment, never in an image or a committed file; compose.prod.yaml builds
# DATABASE_URL from POSTGRES_* and fixes the storage settings. See
# ../docs/CONFIGURATION.md for the full production variable table. A production
# server refuses to start (exit code 78) unless NODE_ENV=production, APP_URL is
# an https origin, DATABASE_URL is a postgres URL, BETTER_AUTH_SECRET has 32+
# characters (not the placeholder below), STORAGE_DRIVER=local,
# STORAGE_LOCAL_PATH is absolute and every bounded number is in range.

# ---------------------------------------------------------------- required --
NODE_ENV=development
# Public base URL of the app (used for auth callbacks and CSRF origin checks).
# Production: the https origin only (no path), e.g. https://links.example.com
APP_URL=http://localhost:3000
# PostgreSQL connection string. Dev services: see ../compose.dev.yaml
DATABASE_URL=postgresql://covalink:covalink_dev@127.0.0.1:5432/covalink
# 32+ random characters. Generate (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# -------------------------------------------------------- initial setup -----
# One-time secret authorizing creation of the super administrator at /setup.
# 32+ random characters. Leave empty to disable /setup; remove after setup.
SETUP_TOKEN=

# ---------------------------------------------------------------- optional --
# Default for public sign-up after setup (admins can override in the DB settings).
REGISTRATION_ENABLED=false
# Require email verification before sign-in (needs working SMTP).
REQUIRE_EMAIL_VERIFICATION=false
MAX_PROFILES_PER_USER=5

# SMTP. Without SMTP_HOST + SMTP_FROM, emails are logged in development and
# dropped (with a warning) in production. Dev Mailpit: host localhost, port 1025.
# A blank SMTP_PORT means unset: 465 with SMTP_SECURE=true, otherwise 587.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="COVALink <no-reply@example.com>"

# Uploaded media (avatars, background images). Only "local" exists.
STORAGE_DRIVER=local
# Storage root. Development may use a relative path (resolved from web/).
# Production REQUIRES an absolute path on a persistent volume (e.g. /data/uploads),
# and that volume must be backed up together with PostgreSQL.
STORAGE_LOCAL_PATH=./data/uploads
# Defaults for the per-user media settings (admins can override in the DB settings).
# Hard upload ceilings (5 MB, 8192 px, 40 MP, one frame) are fixed in code.
MEDIA_QUOTA_MB=50
MEDIA_UPLOADS_PER_HOUR=30

ANALYTICS_RETENTION_DAYS=395

# Set to true ONLY behind a reverse proxy (e.g. Coolify/Traefik) that overwrites
# X-Forwarded-For. Used for per-client auth rate limiting. When false, rate
# limits use one shared bucket per endpoint (safe, but stricter). Behind an
# untrusted proxy, or with the app port reachable directly, keep it false:
# clients could otherwise spoof their address and evade rate limits.
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Isolated local verification ONLY (compose.smoke.yaml, the E2E runner): lets a
# production server accept an http loopback APP_URL. Never set in a deployment.
# COVALINK_ALLOW_LOOPBACK_APP_URL=true

# ------------------------------------------------------------------ tests --
# Must be local databases whose names end in _test, different from DATABASE_URL.
# Created and migrated (never dropped) by: npm run db:test:prepare / npm run db:e2e:prepare
TEST_DATABASE_URL=postgresql://covalink:covalink_dev@127.0.0.1:5432/covalink_test
E2E_DATABASE_URL=postgresql://covalink:covalink_dev@127.0.0.1:5432/covalink_e2e_test
